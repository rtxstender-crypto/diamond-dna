# Optional: Ask DiamondDNA uses deterministic data tools without these values.
# Required for production canonical/Open Graph URLs (for example https://diamond-dna.example):
DIAMONDDNA_SITE_URL=
# Required in Vercel Production for authenticated scheduled data warming.
# Use a random value of at least 16 characters; never expose it with NEXT_PUBLIC_.
CRON_SECRET=
# Optional Ask DiamondDNA provider settings:
# Configure both values to enable server-side AI wording for supported narrative answers.
DIAMONDDNA_ASSISTANT_API_KEY=
DIAMONDDNA_ASSISTANT_MODEL=
# Optional OpenAI-compatible Responses endpoint override:
# DIAMONDDNA_ASSISTANT_API_URL=https://api.openai.com/v1/responses

# Contributor publishing (Supabase Auth + Postgres + Storage):
# Apply supabase/schema.sql, then copy the project API settings here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
